@page "{id:int}"
@model BookStore.Pages.Books.EditModel

<h2>Edit Book</h2>

<form method="post">

    <input type="hidden" asp-for="Book.Id"/>

    <div>
        <label>Title</label>
        <input asp-for="Book.Title" />
    </div>

    <div>
        <label>Author</label>
        <input asp-for="Book.Author" />
    </div>

    <div>
        <label>ISBN</label>
        <input asp-for="Book.ISBN" />
    </div>

    <div>
        <label>Price</label>
        <input asp-for="Book.Price" />
    </div>

    <button type="submit">Update</button>

</form>