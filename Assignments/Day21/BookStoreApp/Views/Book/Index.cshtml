@model List<BookStoreApp.Models.Book>
<th>Actions</th>
<h2>Books</h2>

<p>
    <a asp-action="Create">Add New Book</a>
</p>

<table class="table">
    <tr>
        <th>Id</th>
        <th>Title</th>
        <th>Author</th>
        <th>Price</th>
        <th>Actions</th>
    </tr>

    @foreach(var book in Model)
    {
        <tr>
            <td>@book.Id</td>
            <td>@book.Title</td>
            <td>@book.Author</td>
            <td>@book.Price</td>
            <td>
                <a asp-action="Edit" asp-route-id="@book.Id">Edit</a>
                <a asp-action="Delete" asp-route-id="@book.Id">Delete</a>
            </td>
        </tr>
    }
</table>