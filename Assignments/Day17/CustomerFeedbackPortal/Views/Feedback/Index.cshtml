@model CustomerFeedbackPortal.Models.Feedback
@using CustomerFeedbackPortal.Helpers

@{
    ViewData["Title"] = "Feedback Form";
}

<h2>Customer Feedback Portal</h2>

<form asp-action="Index" method="post">

    <div>
        <label>Name</label>
        @Html.TextBoxFor(m => m.Name,new{@class="form-control"})
    </div>

    <br>

    <div>
        <label>Email</label>
        @Html.TextBoxFor(m => m.Email,new{@class="form-control"})
    </div>

    <br>

    <div>
        <label>Rating</label>
        @Html.DropDownListFor(m => m.Rating,
        new SelectList(new[]
        {
            "1 Star",
            "2 Stars",
            "3 Stars",
            "4 Stars",
            "5 Stars"
        }),
        "Select Rating")
    </div>

    <br>

    <div>
        <label>Comments</label>
        @Html.TextAreaFor(m => m.Comments,
        new { @class="form-control"})
    </div>

    <br>

    <rating-stars count="5"></rating-stars>

    <br>

    @Html.StyledInput("ExtraField","Custom HTML Helper Input")

    <br><br>

    <button type="submit" class="btn btn-primary">
        Submit Feedback
    </button>

</form>

<br>

<a asp-action="Success">View Submitted Feedback</a>