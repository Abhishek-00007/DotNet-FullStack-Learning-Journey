@page
@model RazorProductApp.Pages.Products.IndexModel

<h1>Add Product</h1>

<form method="post">

    <label>Product Name</label>
    <input asp-for="Product.Name" />

    <br /><br />

    <label>Description</label>
    <input asp-for="Product.Description" />

    <br /><br />

    <label>Category 1</label>
    <input asp-for="Product.Categories[0].Name" />

    <br /><br />

    <label>Category 2</label>
    <input asp-for="Product.Categories[1].Name" />

    <br /><br />

    <button type="submit">Save</button>

</form>

<hr />

<h2>Product List</h2>

@foreach(var item in RazorProductApp.Pages.Products.IndexModel.ProductList)
{
    <partial name="_ProductSummary" model="item" />
}